# Base de datos PostgreSQL para las tablas de email marketing (contacts, campaigns, etc.)
DATABASE_URL=postgresql://postgres:PASSWORD@host:5432/railway

SECRET_KEY=cambia-esto-en-produccion-genera-con-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Happy Lápiz <hola@happylapiz.cl>
RESEND_WEBHOOK_SECRET=

FRONTEND_URL=http://localhost:3000
# Public URL of THIS backend (used to build the Shopify OAuth redirect_uri)
BACKEND_PUBLIC_URL=http://localhost:8000

# Legacy single-tenant Happy Lápiz token — only read once, by the
# 0003_backfill_bootstrap_shop migration, to create the first Shop row.
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_DOMAIN=happy-lapiz.myshopify.com

# Multi-tenant Shopify OAuth app (from the Partner Dashboard app you create)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_customers,read_orders,read_products,write_discounts,write_files,write_script_tags
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SHOPIFY_TOKEN_ENCRYPTION_KEY=
